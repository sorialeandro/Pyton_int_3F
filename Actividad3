# Punto 4 y 5
def PromedioAlumno (nombreAlumno , *notas):
    promedio= sum(notas) /len(notas) if len(notas) >=3 else None

    if promedio is None:
        print (f"Error {nombreAlumno}: se necesita al menos 3 notas para calcular el promedio")
        return None

    print(f"{nombreAlumno}: tiene un promedio de {promedio:.2f}")
    return promedio


PromedioAlumno("Juan", 6, 4)

PromedioAlumno("Mario", 7, 8, 9)
